# =============================================================================
# KiteAI — Environment Variables (copy to .env and fill in your values)
# =============================================================================

# ─── Zerodha Kite Connect Credentials ──────────────────────────────────────
# Get these from https://developers.kite.trade
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# ─── Zerodha Login (for auto-login via TOTP) ──────────────────────────────
KITE_USER_ID=your_zerodha_user_id
KITE_PASSWORD=your_zerodha_password
KITE_TOTP_SECRET=your_totp_secret_from_authenticator_app

# ─── System ────────────────────────────────────────────────────────────────
TRADING_MODE=paper              # paper or live
SECRET_KEY=change-me-to-a-random-64-char-string
LOG_LEVEL=INFO
