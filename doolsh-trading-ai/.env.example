# =============================================================================
# Doolsh Trading AI — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# ---- Application ----
APP_NAME=doolsh-trading-ai
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-random-64-char-string
API_VERSION=v1

# ---- Database (SQLite — no config needed) ----
DB_PATH=data/doolsh.db

# ---- Zerodha Kite Connect ----
# Get API key/secret from https://developers.kite.trade
KITE_API_KEY=your-kite-api-key
KITE_API_SECRET=your-kite-api-secret
KITE_USER_ID=AB1234
KITE_PASSWORD=your-kite-password
# TOTP secret for auto-login (Base32 string from your authenticator app setup)
KITE_TOTP_SECRET=your-base32-totp-secret

# ---- Trading ----
# "paper" = simulated orders (safe testing)
# "live"  = REAL orders on Zerodha (use with extreme caution)
TRADING_MODE=paper
TRADING_EXCHANGE=NSE
TRADING_PRODUCT=MIS
DEFAULT_QUANTITY=1
WATCHLIST=["RELIANCE","TCS","INFY","HDFCBANK","ICICIBANK","SBIN","BAJFINANCE","ITC","HINDUNILVR","KOTAKBANK"]

# Market hours (IST)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=15
AUTO_SQUARE_OFF_MINUTE=10

# ---- Risk Management ----
MAX_DAILY_LOSS=5000
MAX_POSITION_VALUE=100000
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_TRADE_COUNT_PER_DAY=20
MIN_CONFIDENCE_THRESHOLD=0.65

# ---- JWT ----
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- ML ----
MODEL_SAVE_DIR=ml/saved_models
DEFAULT_TRAIN_TEST_SPLIT=0.8
CROSS_VALIDATION_FOLDS=5

# ---- AI Features (v2) ----
# Toggle individual AI features on/off
AI_REGIME_DETECTION=true           # Auto-detect market regime each cycle
AI_ADAPTIVE_ENSEMBLE=true          # Dynamic model weighting based on performance
AI_CONFIDENCE_SCORING=true         # Multi-indicator AI confidence scoring
AI_DYNAMIC_SL_TP=true              # ATR/regime-based stop-loss & take-profit
AI_VOLATILITY_SIZING=true          # Volatility-adjusted position sizing
AI_SIGNAL_QUALITY_FILTER=true      # Filter out low-quality (D-grade) signals
AI_MULTI_TIMEFRAME=true            # Multi-timeframe signal alignment
AI_TILT_PROTECTION=true            # Pause trading after consecutive losses
AI_TRANSFORMER_ENABLED=true        # Enable Transformer attention model
AI_ENSEMBLE_MODE=adaptive          # "adaptive" (performance-weighted), "simple" (majority vote), "single"

# Transformer model hyperparameters
TRANSFORMER_D_MODEL=64             # Model dimension (embedding size)
TRANSFORMER_N_HEADS=4              # Number of attention heads
TRANSFORMER_N_LAYERS=3             # Number of transformer blocks
TRANSFORMER_SEQ_LEN=30             # Input sequence length (trading days)
TRANSFORMER_DROPOUT=0.2            # Dropout rate

# ---- Scheduler ----
SCHEDULER_INTERVAL_SECONDS=60

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
