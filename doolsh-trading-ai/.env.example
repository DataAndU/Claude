# =============================================================================
# Doolsh Trading AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# ---- Application ----
APP_NAME=doolsh-trading-ai
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
API_VERSION=v1

# ---- Database ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=doolsh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=doolsh_trading

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ---- Celery ----
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ---- JWT ----
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Market Data ----
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
DATA_CACHE_TTL_SECONDS=300

# ---- ML ----
MODEL_SAVE_DIR=ml/saved_models
DEFAULT_TRAIN_TEST_SPLIT=0.8
CROSS_VALIDATION_FOLDS=5

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
